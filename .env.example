# Flask secret key – generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database connection string
# Production (Neon PostgreSQL): postgresql://user:password@host/dbname
# Local development: leave empty to use SQLite (sqlite:///instance/dar.db)
DATABASE_URL=

# Environment: "development" or "production"
FLASK_ENV=development

# (Optional) Full path to the Tesseract OCR executable
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Mac/Linux: usually not needed if installed via brew/apt
TESSERACT_CMD=
